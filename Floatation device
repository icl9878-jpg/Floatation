--------------------------------------------------------------------------------
-- LOCKED AIR WALK SYSTEM
--------------------------------------------------------------------------------

local function createPlatform()
	if not airPlatform then
		airPlatform = Instance.new("Part")
		airPlatform.Name = "AirWalkPlatform"
		airPlatform.Size = Vector3.new(15, 1, 15)
		airPlatform.Transparency = 1 -- Fully invisible
		airPlatform.Anchored = true
		airPlatform.CanCollide = true
		airPlatform.Material = Enum.Material.SmoothPlastic
		airPlatform.Parent = workspace
	end
end

local function destroyPlatform()
	if airPlatform then
		airPlatform:Destroy()
		airPlatform = nil
	end
end

local function toggleAirWalk()
	character = player.Character
	if not character or not character:FindFirstChild("HumanoidRootPart") then return end
	rootPart = character.HumanoidRootPart
	
	isAirWalkActive = not isAirWalkActive
	
	if isAirWalkActive then
		toggleBtn.BackgroundColor3 = Color3.fromRGB(50, 180, 80)
		toggleBtn.Text = "Air Walk: ON"
		-- Lock floor height to current feet position
		floatHeight = rootPart.Position.Y - 3.1
		createPlatform()
	else
		toggleBtn.BackgroundColor3 = Color3.fromRGB(180, 50, 50)
		toggleBtn.Text = "Air Walk: OFF"
		destroyPlatform()
	end
end

toggleBtn.MouseButton1Click:Connect(toggleAirWalk)

closeBtn.MouseButton1Click:Connect(function()
	mainFrame.Visible = false
end)

-- Platform stays exactly under your X/Z coordinates at the fixed floatHeight
RunService.Heartbeat:Connect(function()
	if not isAirWalkActive or not airPlatform then return end
	
	character = player.Character
	if not character or not character:FindFirstChild("HumanoidRootPart") then return end
	rootPart = character.HumanoidRootPart
	
	-- Keep platform centered under player at the locked height
	airPlatform.CFrame = CFrame.new(rootPart.Position.X, floatHeight, rootPart.Position.Z)
end)

-- Manual Height Control
UserInputService.InputBegan:Connect(function(input, gameProcessed)
	if gameProcessed then return end
	
	if input.KeyCode == Enum.KeyCode.RightControl then
		mainFrame.Visible = not mainFrame.Visible
	end
	
	if not isAirWalkActive or not rootPart then return end
	
	-- SPACE: Raises floor height and moves you up
	if input.KeyCode == Enum.KeyCode.Space then
		floatHeight = floatHeight + jumpBoost
		rootPart.CFrame = CFrame.new(rootPart.Position.X, floatHeight + 3.2, rootPart.Position.Z)
		if humanoid then
			humanoid:ChangeState(Enum.HumanoidStateType.Jumping)
		end
	end
	
	-- LEFT SHIFT: Lowers floor height
	if input.KeyCode == Enum.KeyCode.LeftShift then
		floatHeight = floatHeight - jumpBoost
		rootPart.CFrame = CFrame.new(rootPart.Position.X, floatHeight + 3.2, rootPart.Position.Z)
	end
end)

-- Character death / respawn handler
player.CharacterAdded:Connect(function(newChar)
	character = newChar
	rootPart = character:WaitForChild("HumanoidRootPart")
	humanoid = character:WaitForChild("Humanoid")
	isAirWalkActive = false
	toggleBtn.BackgroundColor3 = Color3.fromRGB(180, 50, 50)
	toggleBtn.Text = "Air Walk: OFF"
	destroyPlatform()
end)
